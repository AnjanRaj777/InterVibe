{
  "name": "intervibe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "npm run build --workspace=@intervibe/contracts",
    "pretypecheck": "npm run build --workspace=@intervibe/contracts",
    "pretest": "npm run build --workspace=@intervibe/contracts",
    "prebuild": "npm run build --workspace=@intervibe/contracts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "build": "npm run build --workspaces --if-present"
  }
}
