# Copy to .env and fill in. Never commit real values.
# Server-side only — nothing here is exposed to the browser.

# Meta Model API key (Standard mode). Never use a -contributor key with user data.
MODEL_API_KEY=

# Postgres connection string (docker-compose provides a local one).
DATABASE_URL=postgres://intervibe:intervibe@localhost:5432/intervibe

# S3-compatible storage for resumes/JDs (MinIO in docker-compose for local dev).
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=intervibe-docs
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# Auth: random 32+ byte secret, and the public web URL for magic-link redirects.
AUTH_SECRET=
APP_URL=http://localhost:3000

# API port.
PORT=8787

# Groq API key for ultra-low latency TTS (canopylabs/orpheus-v1-english)
# Get a key from https://console.groq.com/keys
GROQ_API_KEY=
