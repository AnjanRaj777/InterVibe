{
  "name": "@intervibe/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build --workspace=@intervibe/contracts --prefix ../..",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "prebuild": "npm run build --workspace=@intervibe/contracts --prefix ../..",
    "build": "tsc -p tsconfig.build.json",
    "pretypecheck": "npm run build --workspace=@intervibe/contracts --prefix ../..",
    "typecheck": "tsc -p tsconfig.json",
    "pretest": "npm run build --workspace=@intervibe/contracts --prefix ../..",
    "test": "vitest run",
    "lint": "eslint src test",
    "smoke": "tsx src/meta/smoke.ts",
    "migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1157.0",
    "@aws-sdk/s3-request-presigner": "^3.1157.0",
    "@hono/node-server": "^1.13.2",
    "@intervibe/contracts": "0.1.0",
    "@types/ws": "^8.18.2",
    "dotenv": "^18.0.9",
    "hono": "^4.6.0",
    "mammoth": "^1.13.0",
    "pg": "^8.13.0",
    "unpdf": "^1.9.1",
    "ws": "^8.22.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.0",
    "eslint": "^9.12.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "vitest": "^3.0.0"
  }
}
